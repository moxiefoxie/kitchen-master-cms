{
  "kind": "collectionType",
  "collectionName": "homepage_sections",
  "info": { "singularName": "homepage-section", "pluralName": "homepage-sections", "displayName": "Homepage Section", "description": "Editable homepage sections. Use the Restaurant dropdown for a shared section or a restaurant-specific override." },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "sectionKey": { "type": "enumeration", "enum": ["location-gateway", "reservations", "story", "featured-menu", "food-menu", "drinks", "happy-hour", "dining-feature", "private-dining", "social-proof", "locations", "connect", "footer"], "required": true },
    "restaurantScope": { "type": "enumeration", "enum": ["all", "suwanee", "frisco", "southlake", "midtown"], "default": "all", "required": true, "description": "Controls website visibility and provides dropdown filtering. Choose all for the shared section or one restaurant for an override." },
    "location": { "type": "relation", "relation": "manyToOne", "target": "api::location.location", "description": "Legacy relation retained for existing entries. The Restaurant dropdown controls visibility." },
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "accent": { "type": "string" },
    "body": { "type": "text" },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "images": { "type": "media", "multiple": true, "allowedTypes": ["images"], "description": "Ordered images for card-based sections such as Featured Menu" },
    "caption": { "type": "string" },
    "items": { "type": "json", "description": "Optional cards or disclaimer lines for this section" },
    "linkLabel": { "type": "string" },
    "linkUrl": { "type": "string" },
    "sortOrder": { "type": "integer", "default": 0 }
  },
  "config": {
    "layouts": { "list": ["name", "sectionKey", "restaurantScope", "sortOrder"] }
  }
}
