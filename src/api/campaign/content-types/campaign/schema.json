{
  "kind": "collectionType",
  "collectionName": "campaigns",
  "info": {
    "singularName": "campaign",
    "pluralName": "campaigns",
    "displayName": "Campaign Popup",
    "description": "Scheduled, location-aware website popups such as Insiders signup and seasonal voting"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "campaignType": { "type": "enumeration", "enum": ["insiders", "external-cta"], "required": true },
    "enabled": { "type": "boolean", "default": true, "required": true },
    "startsAt": { "type": "datetime" },
    "endsAt": { "type": "datetime" },
    "priority": { "type": "integer", "default": 0 },
    "restaurantScope": { "type": "enumeration", "enum": ["all", "suwanee", "frisco", "southlake", "midtown", "multiple"], "default": "all", "required": true, "description": "Controls website visibility and provides dropdown filtering. Choose all for every restaurant; choose multiple only when Locations contains more than one restaurant." },
    "locations": { "type": "relation", "relation": "manyToMany", "target": "api::location.location", "description": "Only required when Restaurant is multiple. Otherwise the Restaurant dropdown controls visibility." },
    "eyebrow": { "type": "string" },
    "title": { "type": "string", "required": true },
    "accent": { "type": "string" },
    "body": { "type": "text" },
    "buttonLabel": { "type": "string" },
    "buttonUrl": { "type": "string" },
    "finePrint": { "type": "text" },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "dismissalKey": { "type": "string", "required": true, "unique": true },
    "delayMs": { "type": "integer", "default": 1200, "min": 0, "max": 30000 }
  },
  "config": {
    "layouts": { "list": ["name", "restaurantScope", "enabled", "startsAt"] }
  }
}
