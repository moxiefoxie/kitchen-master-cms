{
  "kind": "collectionType",
  "collectionName": "allergens",
  "info": {
    "singularName": "allergen",
    "pluralName": "allergens",
    "displayName": "Allergen",
    "description": "Reusable allergen options selected on menu items"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true, "unique": true },
    "shortLabel": { "type": "string", "required": true, "maxLength": 3, "description": "Compact label shown inside the website icon, such as M, TN, or SE" },
    "sortOrder": { "type": "integer", "default": 0 },
    "items": { "type": "relation", "relation": "manyToMany", "target": "api::menu-item.menu-item", "mappedBy": "allergens" }
  },
  "config": {
    "layouts": { "list": ["name", "shortLabel", "sortOrder"] }
  }
}
