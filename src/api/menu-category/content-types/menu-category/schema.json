{
  "kind": "collectionType",
  "collectionName": "menu_categories",
  "info": {
    "singularName": "menu-category",
    "pluralName": "menu-categories",
    "displayName": "Menu Category"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "menuType": { "type": "enumeration", "enum": ["food", "drink"], "required": true },
    "note": { "type": "text" },
    "sortOrder": { "type": "integer", "default": 0 },
    "items": { "type": "relation", "relation": "oneToMany", "target": "api::menu-item.menu-item", "mappedBy": "category" }
  }
}
