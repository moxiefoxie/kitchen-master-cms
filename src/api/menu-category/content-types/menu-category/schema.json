{
  "kind": "collectionType",
  "collectionName": "menu_categories",
  "info": {
    "singularName": "menu-category",
    "pluralName": "menu-categories",
    "displayName": "Menu Category",
    "description": "Food, drink, and happy-hour groupings. Filter by Restaurants; an empty Restaurants field applies everywhere."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "menuType": { "type": "enumeration", "enum": ["food", "drink", "happy-hour"], "required": true },
    "note": { "type": "text" },
    "sortOrder": { "type": "integer", "default": 0 },
    "items": { "type": "relation", "relation": "oneToMany", "target": "api::menu-item.menu-item", "mappedBy": "category" },
    "locations": { "type": "relation", "relation": "manyToMany", "target": "api::location.location", "mappedBy": "menuCategories", "description": "Leave empty to show this category at every restaurant." }
  },
  "config": {
    "layouts": { "list": ["name", "menuType", "locations", "sortOrder"] }
  }
}
