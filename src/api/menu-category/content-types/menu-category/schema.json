{
  "kind": "collectionType",
  "collectionName": "menu_categories",
  "info": {
    "singularName": "menu-category",
    "pluralName": "menu-categories",
    "displayName": "Menu Category",
    "description": "Food, drink, and happy-hour groupings. Use the Restaurant dropdown to control and filter where each category appears."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "menuType": { "type": "enumeration", "enum": ["food", "drink", "happy-hour"], "required": true },
    "note": { "type": "text" },
    "sortOrder": { "type": "integer", "default": 0 },
    "items": { "type": "relation", "relation": "oneToMany", "target": "api::menu-item.menu-item", "mappedBy": "category" },
    "restaurantScope": { "type": "enumeration", "enum": ["all", "suwanee", "frisco", "southlake", "midtown", "multiple"], "default": "all", "required": true, "description": "Controls website visibility and provides dropdown filtering. Choose all for every restaurant; choose multiple only when Locations contains more than one restaurant." },
    "locations": { "type": "relation", "relation": "manyToMany", "target": "api::location.location", "mappedBy": "menuCategories", "description": "Only required when Restaurant is multiple. Otherwise the Restaurant dropdown controls visibility." }
  },
  "config": {
    "layouts": { "list": ["name", "menuType", "restaurantScope", "sortOrder"] }
  }
}
