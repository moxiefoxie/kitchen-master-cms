{
  "kind": "collectionType",
  "collectionName": "happenings",
  "info": {
    "singularName": "happening",
    "pluralName": "happenings",
    "displayName": "Happening",
    "description": "Location-aware specials, events, and optional dismissible header announcements. Leave Locations empty to show at every restaurant."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "happeningType": { "type": "enumeration", "enum": ["event", "special"], "default": "event", "required": true },
    "enabled": { "type": "boolean", "default": true, "required": true },
    "featured": { "type": "boolean", "default": false },
    "eyebrow": { "type": "string" },
    "summary": { "type": "text" },
    "details": { "type": "text" },
    "startsAt": { "type": "datetime" },
    "endsAt": { "type": "datetime" },
    "schedule": { "type": "string", "description": "Optional display text such as Weekdays, 4–6 PM" },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "buttonLabel": { "type": "string" },
    "buttonUrl": { "type": "string" },
    "locations": { "type": "relation", "relation": "manyToMany", "target": "api::location.location", "description": "Optional. Leave empty to display at all locations." },
    "showInBanner": { "type": "boolean", "default": false, "description": "Show this item in the dismissible bar beneath the site header while active." },
    "dismissalKey": { "type": "string", "description": "Change this value when you want a previously dismissed banner to appear again." },
    "priority": { "type": "integer", "default": 0 },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
