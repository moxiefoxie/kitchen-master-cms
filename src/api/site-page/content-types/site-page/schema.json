{
  "kind": "collectionType",
  "collectionName": "site_pages",
  "info": {
    "singularName": "site-page",
    "pluralName": "site-pages",
    "displayName": "Site Page",
    "description": "Editable global or location-specific website pages"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "pageType": { "type": "enumeration", "enum": ["home", "story", "private-dining", "contact", "careers", "franchise", "custom"], "required": true },
    "location": { "type": "relation", "relation": "manyToOne", "target": "api::location.location" },
    "heroEyebrow": { "type": "string" },
    "heroTitle": { "type": "string" },
    "heroAccent": { "type": "string" },
    "heroDescription": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"], "description": "Page background image. On Home, this is the global background unless a Location has its own hero image." },
    "gatewayEyebrow": { "type": "string" },
    "gatewayTitle": { "type": "string" },
    "gatewayAccent": { "type": "string" },
    "gatewayDescription": { "type": "text" },
    "storyEyebrow": { "type": "string" },
    "storyTitle": { "type": "string" },
    "storyAccent": { "type": "string" },
    "storyBody": { "type": "text" },
    "storyImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "menuIntroEyebrow": { "type": "string" },
    "menuIntroTitle": { "type": "string" },
    "menuIntroAccent": { "type": "string" },
    "menuCard1Eyebrow": { "type": "string" },
    "menuCard1Title": { "type": "string" },
    "menuCard1Image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "menuCard2Eyebrow": { "type": "string" },
    "menuCard2Title": { "type": "string" },
    "menuCard2Image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "menuCard3Eyebrow": { "type": "string" },
    "menuCard3Title": { "type": "string" },
    "menuCard3Image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "foodMenuTitle": { "type": "string" },
    "foodMenuDescription": { "type": "text" },
    "foodMenuDisclaimer": { "type": "text" },
    "drinkEyebrow": { "type": "string" },
    "drinkTitle": { "type": "string" },
    "drinkAccent": { "type": "string" },
    "drinkDescription": { "type": "text" },
    "drinkDisclaimer": { "type": "text" },
    "featureEyebrow": { "type": "string" },
    "featureTitle": { "type": "string" },
    "featureAccent": { "type": "string" },
    "featureBody": { "type": "text" },
    "featureImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "privateDiningEyebrow": { "type": "string" },
    "privateDiningTitle": { "type": "string" },
    "privateDiningAccent": { "type": "string" },
    "privateDiningBody": { "type": "text" },
    "privateDiningImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "privateDiningCaption": { "type": "string" },
    "connectEyebrow": { "type": "string" },
    "connectTitle": { "type": "string" },
    "connectAccent": { "type": "string" },
    "footerTagline": { "type": "string" },
    "footerCopyright": { "type": "string" },
    "sections": { "type": "json" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "text" },
    "seoKeywords": { "type": "json" },
    "socialImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "canonicalUrl": { "type": "string" },
    "noIndex": { "type": "boolean", "default": false },
    "structuredData": { "type": "json" },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
