{
  "kind": "collectionType",
  "collectionName": "site_pages",
  "info": {
    "singularName": "site-page",
    "pluralName": "site-pages",
    "displayName": "Site Page",
    "description": "Editable global or location-specific website pages"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "pageType": { "type": "enumeration", "enum": ["home", "story", "private-dining", "contact", "careers", "franchise", "happenings", "specials", "custom"], "required": true },
    "restaurantScope": { "type": "enumeration", "enum": ["all", "suwanee", "frisco", "southlake", "midtown"], "default": "all", "required": true, "description": "Controls website visibility and provides dropdown filtering. Choose all for the shared page or one restaurant for a location-specific page." },
    "location": { "type": "relation", "relation": "manyToOne", "target": "api::location.location", "description": "Legacy relation retained for existing entries. The Restaurant dropdown controls visibility." },
    "heroEyebrow": { "type": "string" },
    "heroTitle": { "type": "string" },
    "heroAccent": { "type": "string" },
    "heroDescription": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"], "description": "Page background image. On Home, this is the global background unless a Location has its own hero image." },
    "sections": { "type": "json" },
    "formConfig": { "type": "json", "description": "Optional form headings, button label, and select options for Contact, Private Dining, Franchise, or Careers pages" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "text" },
    "seoKeywords": { "type": "json" },
    "socialImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "canonicalUrl": { "type": "string" },
    "noIndex": { "type": "boolean", "default": false },
    "structuredData": { "type": "json" },
    "sortOrder": { "type": "integer", "default": 0 }
  },
  "config": {
    "layouts": { "list": ["title", "pageType", "restaurantScope", "sortOrder"] }
  }
}
