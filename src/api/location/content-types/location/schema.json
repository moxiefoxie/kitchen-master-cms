{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Location",
    "description": "Kitchen Master restaurant locations"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "state": { "type": "string", "required": true },
    "address": { "type": "string", "required": true },
    "city": { "type": "string", "required": true },
    "phone": { "type": "string" },
    "contactEmail": { "type": "email", "required": true, "description": "Recipient for this location's contact form" },
    "privateDiningEmail": { "type": "email", "required": true, "description": "Recipient for this location's private dining inquiries" },
    "websiteUrl": { "type": "string" },
    "latitude": { "type": "decimal" },
    "longitude": { "type": "decimal" },
    "locationStatus": { "type": "enumeration", "enum": ["open", "coming-soon"], "default": "open", "required": true },
    "hours": { "type": "text" },
    "orderUrl": { "type": "string" },
    "reservationUrl": { "type": "string" },
    "instagramUrl": { "type": "string" },
    "facebookUrl": { "type": "string" },
    "googleReviewsUrl": { "type": "string" },
    "googleRating": { "type": "decimal", "min": 0, "max": 5 },
    "googleReviewCount": { "type": "string", "description": "Display text such as 444 Google reviews" },
    "reviews": { "type": "json", "description": "Curated review cards for this location: [{quote, author, rating}]" },
    "hiringEmail": { "type": "email", "required": true, "description": "Recipient for applications submitted from this location's careers page" },
    "hiringRoles": { "type": "json", "description": "Role options shown on this location's careers page, for example [\"Server\", \"Bartender\"]" },
    "sortOrder": { "type": "integer", "default": 0 },
    "heroEyebrow": { "type": "string" },
    "heroTitle": { "type": "string" },
    "heroAccent": { "type": "string" },
    "heroDescription": { "type": "text" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"], "description": "Homepage background shown when this restaurant is selected. Overrides the global Home image." },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "text" },
    "seoKeywords": { "type": "json" },
    "menuCategories": { "type": "relation", "relation": "manyToMany", "target": "api::menu-category.menu-category", "inversedBy": "locations" }
  }
}
